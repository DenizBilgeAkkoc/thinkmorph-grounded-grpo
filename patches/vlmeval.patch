+    def split_thinking(self, text):
+        """Score the terminal native answer; retain the entire trace for audit.
+
+        Activated by VLMEvalKit's SPLIT_THINK option. In particular, circular
+        exact matching must not search earlier reasoning for option letters.
+        """
+        terminal = re.split(r"(?m)^Round_\d+:\n", text)[-1]
+        answers = re.findall(r"<answer>(.*?)</answer>", terminal, flags=re.S)
+        ends_in_image = re.search(r"\[Image:[^\n]+\]\s*$", text) is not None
+        answer = answers[0].strip() if len(answers) == 1 and not ends_in_image else ""
+        return answer or "[NO_FINAL_ANSWER]", text
+
     def __init__(self, model_path='ThinkMorph/ThinkMorph-7B', think=True, understanding_output=True, save_dir=None, temperature=0.3, max_think_token_n=4096, **kwargs):
         # self.check_install()
         assert model_path is not None
